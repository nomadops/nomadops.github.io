<header class="site-header dark">
  <nav class="nav container" aria-label="Main">
    <a class="brand" href="/"><img src="/images/corgi-logo-96.webp" alt="" width="44" height="44">nomadops</a>
    <ul class="nav-links">
      {% for item in site.nav %}<li><a href="{{ item.href }}"{% if item.href == page.url %} aria-current="page"{% endif %}>{{ item.label }}</a></li>
      {% endfor %}<li><a class="btn btn-primary btn-sm" href="{{ site.cta.href }}">{{ site.cta.label }}</a></li>
    </ul>
  </nav>
</header>
