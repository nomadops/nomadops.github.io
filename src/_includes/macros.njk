{# Small reusable fragments. Mirror of design-system/components (Arrows, More, Pill, Badge, Dot, Eyebrow). #}
{% macro arrows(items, gap) %}<ul class="arrows">{% for i in items %}<li>{{ i }}</li>{% endfor %}</ul>{% endmacro %}
{% macro more(label, href) %}<a class="more" href="{{ href }}">{{ label }} <span aria-hidden="true">→</span></a>{% endmacro %}
{% macro eyebrow(text) %}<p class="eyebrow">{{ text }}</p>{% endmacro %}
{% macro pill(text) %}<span class="pill">{{ text }}</span>{% endmacro %}
{% macro badge(approval) %}<span class="badge{% if approval %} badge-approval{% endif %}">{{ "needs approval" if approval else "read" }}</span>{% endmacro %}
{% macro dot(tone) %}<span class="dot dot-{{ tone }}" aria-hidden="true"></span>{% endmacro %}
{% macro chevron() %}<svg aria-hidden="true" focusable="false" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 3l5 5-5 5"/></svg>{% endmacro %}
{% macro icon(name) %}<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">{% if name == "fixer" %}<path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/>{% elif name == "debugger" %}<circle cx="11" cy="11" r="7"/><path d="M21 21l-5-5"/>{% else %}<circle cx="4" cy="12" r="2"/><circle cx="12" cy="12" r="2"/><circle cx="20" cy="12" r="2"/><path d="M6 12h4M14 12h4"/>{% endif %}</svg>{% endmacro %}
